{
  "name": "copybook-ts",
  "version": "0.1.0",
  "description": "Parse COBOL copybooks and decode mainframe fixed-width records in TypeScript: COMP-3, EBCDIC, implied decimal point and zone sign",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "copybook-types": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daopapp/copybook-ts.git"
  },
  "homepage": "https://github.com/daopapp/copybook-ts#readme",
  "bugs": "https://github.com/daopapp/copybook-ts/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf dist && tsc && node --test dist/test/*.test.js",
    "ebcdic": "python3 tools/generate-ebcdic.py > src/ebcdic.ts",
    "codegen:fixture": "npm run build && node dist/src/cli.js test/fixtures/customer.cpy --from ../../src/index.js > test/fixtures/customer.generated.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cobol",
    "copybook",
    "mainframe",
    "ebcdic",
    "comp-3",
    "packed-decimal",
    "zos",
    "fixed-width",
    "legacy"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  }
}

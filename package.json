{
  "name": "copybook-ts",
  "version": "0.1.0",
  "description": "Parse COBOL copybooks and decode mainframe fixed-width records in TypeScript: COMP-3, EBCDIC, implied decimal point and zone sign",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf dist && tsc && node --test dist/test/*.test.js",
    "ebcdic": "python3 tools/generate-ebcdic.py > src/ebcdic.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cobol",
    "copybook",
    "mainframe",
    "ebcdic",
    "comp-3",
    "packed-decimal",
    "zos",
    "fixed-width",
    "legacy"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  }
}
